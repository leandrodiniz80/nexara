# =========================================================
# Elevel Prospect AI — Environment Variables (example)
# Copie este arquivo para ".env" e ajuste os valores.
# =========================================================

# ---------- General ----------
ENVIRONMENT=development
PROJECT_NAME="Elevel Prospect AI"

# ---------- Frontend ----------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
FRONTEND_PORT=3000

# ---------- Backend ----------
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# ---------- PostgreSQL ----------
POSTGRES_HOST=database
POSTGRES_PORT=5432
POSTGRES_DB=elevel_prospect_ai
POSTGRES_USER=elevel
POSTGRES_PASSWORD=change-me-in-production
DATABASE_URL=postgresql+asyncpg://elevel:change-me-in-production@database:5432/elevel_prospect_ai

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# ---------- Celery ----------
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---------- Nginx ----------
NGINX_PORT=80

# ---------- AI / Prospect Providers ----------
# Chaves de provedores de IA usadas pelos prompts em /prompts
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
